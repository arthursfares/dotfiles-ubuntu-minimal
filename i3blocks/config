# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=15

[nordvpn]
command=$HOME/.config/i3blocks/nordvpn.sh
interval=10

[iface]
command=$HOME/.config/i3blocks/i3blocks-contrib/iface/iface
#LABEL=wlan0:
#IFACE=wlan0
#ADDRESS_FAMILY=inet6?
color=#00FF00
interval=10
# set this to 1 to display the name of the connected WIFI interface instead of the IP address.
display_wifi_name=0

[bluetooth]
command=$HOME/.config/i3blocks/bluetooth.sh
interval=5

[volume]
command=~/.config/i3blocks/i3blocks-contrib/volume-pipewire/volume-pipewire
#LABEL=♪ 
LABEL=VOL 
interval=persist
#signal=10
#STEP=5%
#MIXER=[determined automatically]
#SCONTROL=[determined automatically]
SUBSCRIBE=1
AUDIO_HIGH_SYMBOL=VOL
AUDIO_MED_SYMBOL=VOL
AUDIO_LOW_SYMBOL=VOL
AUDIO_MUTED_SYMBOL=MUTED
LONG_FORMAT="${SYMB} ${VOL}%"

[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1

[power]
command=$HOME/.config/i3blocks/power.sh
interval=once

